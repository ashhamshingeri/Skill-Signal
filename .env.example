# SkillSignal Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/skillsignal

# Backend
PORT=3001
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Frontend
VITE_API_URL=http://localhost:3001/api

# AI/LLM (optional - fallback engine works without this)
LLM_API_KEY=
LLM_MODEL=

# ML Service
ML_SERVICE_URL=http://localhost:5000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20
